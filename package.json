{
  "name": "hckr-tools-browser-extension",
  "version": "1.0.0",
  "description": "hckr-tools — Developer Utility Toolkit Browser Extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && cp public/manifest.json dist/ && cp src/content/widget.css dist/content/",
    "clean": "rm -rf dist hckr-tools-browser-extension.zip",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "zip": "cd dist && zip -r ../hckr-tools-browser-extension.zip ."
  },
  "dependencies": {
    "apache-arrow": "^21.2.0",
    "js-yaml": "^5.4.1",
    "parquet-wasm": "^0.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.287",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
