{
  "manifest_version": 3,
  "name": "hckr-tools — Developer Utility Toolkit",
  "version": "1.0.0",
  "description": "Essential developer utilities in your browser side panel. JSON formatter, Base64, UUID, timestamps, JWT decoder & more. Fully offline, privacy-first.",
  "action": {
    "default_title": "Open hckr-tools"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/detector.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "activeTab"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      }
    },
    "switch-to-previous-tab": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Switch to previously active tab"
    },
    "open-tab-switcher": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Open the hckr-tools tab switcher"
    }
  }
}
