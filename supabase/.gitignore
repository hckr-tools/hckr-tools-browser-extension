*** Add File: /Users/ashishpatel/pateash/hckr-browser-ext/supabase/tests/workspace_sync_rls.test.sql
begin;

select plan(30);

insert into auth.users (
  instance_id,
  id,
  aud,
  role,
  email,
  encrypted_password,
  email_confirmed_at,
  raw_app_meta_data,
  raw_user_meta_data,
  created_at,
  updated_at
) values
  (
    '00000000-0000-0000-0000-000000000000',
    '11111111-1111-1111-1111-111111111111',
    'authenticated',
    'authenticated',
    'workspace-owner@example.test',
    '',
    now(),
    '{}'::jsonb,
    '{}'::jsonb,
    now(),
    now()
  ),
  (
    '00000000-0000-0000-0000-000000000000',
    '22222222-2222-2222-2222-222222222222',
    'authenticated',
    'authenticated',
    'workspace-other@example.test',
    '',
    now(),
    '{}'::jsonb,
    '{}'::jsonb,
    now(),
    now()
  );

insert into public.workspaces (id, owner_id, name)
values ('workspace-owner', '11111111-1111-1111-1111-111111111111', 'Owner workspace');

insert into public.board_columns (id, owner_id, workspace_id, name, position)
values ('column-owner', '11111111-1111-1111-1111-111111111111', 'workspace-owner', 'Inbox', 0);

insert into public.board_cards (id, owner_id, workspace_id, column_id, title, position)
values ('card-owner', '11111111-1111-1111-1111-111111111111', 'workspace-owner', 'column-owner', 'Owner card', 0);

insert into public.saved_items (id, owner_id, workspace_id, type, title, content)
values ('item-owner', '11111111-1111-1111-1111-111111111111', 'workspace-owner', 'text', 'Owner item', 'owner content');

insert into public.saved_item_versions (id, owner_id, item_id, content, revision)
values ('version-owner', '11111111-1111-1111-1111-111111111111', 'item-owner', 'owner content', 1);

create function public.test_hckr_rls_denied(statement text)
returns boolean
language plpgsql
as $$
begin
  execute statement;
  return false;
exception when insufficient_privilege then
  return true;
end;
$$;

set local role authenticated;
select set_config('request.jwt.claim.sub', '11111111-1111-1111-1111-111111111111', true);

select lives_ok(
  $$insert into public.workspaces (id, owner_id, name) values ('workspace-owner-new', '11111111-1111-1111-1111-111111111111', 'New workspace')$$,
  'owner can insert a workspace'
);
select lives_ok(
  $$insert into public.board_columns (id, owner_id, workspace_id, name, position) values ('column-owner-new', '11111111-1111-1111-1111-111111111111', 'workspace-owner', 'Working', 1)$$,
  'owner can insert a board column'
);
select lives_ok(
  $$insert into public.board_cards (id, owner_id, workspace_id, column_id, title, position) values ('card-owner-new', '11111111-1111-1111-1111-111111111111', 'workspace-owner', 'column-owner', 'New card', 1)$$,
  'owner can insert a board card'
);
select lives_ok(
  $$insert into public.saved_items (id, owner_id, workspace_id, type, title, content) values ('item-owner-new', '11111111-1111-1111-1111-111111111111', 'workspace-owner', 'text', 'New item', 'new content')$$,
  'owner can insert a saved item'
);
select lives_ok(
  $$insert into public.saved_item_versions (id, owner_id, item_id, content, revision) values ('version-owner-new', '11111111-1111-1111-1111-111111111111', 'item-owner', 'new version', 2)$$,
  'owner can insert a saved item version'
);

select is((select count(*) from public.workspaces where id = 'workspace-owner'), 1::bigint, 'owner can select a workspace');
select is((select count(*) from public.board_columns where id = 'column-owner'), 1::bigint, 'owner can select a board column');
select is((select count(*) from public.board_cards where id = 'card-owner'), 1::bigint, 'owner can select a board card');
select is((select count(*) from public.saved_items where id = 'item-owner'), 1::bigint, 'owner can select a saved item');
select is((select count(*) from public.saved_item_versions where id = 'version-owner'), 1::bigint, 'owner can select a saved item version');

select lives_ok($$update public.workspaces set name = 'Owner updated' where id = 'workspace-owner'$$, 'owner can update a workspace');
select lives_ok($$update public.board_columns set name = 'Owner updated' where id = 'column-owner'$$, 'owner can update a board column');
select lives_ok($$update public.board_cards set title = 'Owner updated' where id = 'card-owner'$$, 'owner can update a board card');
select lives_ok($$update public.saved_items set title = 'Owner updated' where id = 'item-owner'$$, 'owner can update a saved item');
select lives_ok($$update public.saved_item_versions set content = 'Owner updated' where id = 'version-owner'$$, 'owner can update a saved item version');

reset role;
set local role authenticated;
select set_config('request.jwt.claim.sub', '22222222-2222-2222-2222-222222222222', true);

select is((select count(*) from public.workspaces), 0::bigint, 'other user cannot select workspaces');
select is((select count(*) from public.board_columns), 0::bigint, 'other user cannot select board columns');
select is((select count(*) from public.board_cards), 0::bigint, 'other user cannot select board cards');
select is((select count(*) from public.saved_items), 0::bigint, 'other user cannot select saved items');
select is((select count(*) from public.saved_item_versions), 0::bigint, 'other user cannot select saved item versions');

select is(public.test_hckr_rls_denied($$insert into public.workspaces (id, owner_id, name) values ('workspace-denied', '11111111-1111-1111-1111-111111111111', 'Denied')$$), true, 'other user cannot insert a workspace for owner');
select is(public.test_hckr_rls_denied($$insert into public.board_columns (id, owner_id, workspace_id, name, position) values ('column-denied', '11111111-1111-1111-1111-111111111111', 'workspace-owner', 'Denied', 2)$$), true, 'other user cannot insert a board column for owner');
select is(public.test_hckr_rls_denied($$insert into public.board_cards (id, owner_id, workspace_id, column_id, title, position) values ('card-denied', '11111111-1111-1111-1111-111111111111', 'workspace-owner', 'column-owner', 'Denied', 2)$$), true, 'other user cannot insert a board card for owner');
select is(public.test_hckr_rls_denied($$insert into public.saved_items (id, owner_id, workspace_id, type, title, content) values ('item-denied', '11111111-1111-1111-1111-111111111111', 'workspace-owner', 'text', 'Denied', 'Denied')$$), true, 'other user cannot insert a saved item for owner');
select is(public.test_hckr_rls_denied($$insert into public.saved_item_versions (id, owner_id, item_id, content, revision) values ('version-denied', '11111111-1111-1111-1111-111111111111', 'item-owner', 'Denied', 3)$$), true, 'other user cannot insert a saved item version for owner');

select is(public.test_hckr_rls_denied($$update public.workspaces set name = 'Denied' where id = 'workspace-owner'$$), false, 'other user update is filtered without changing workspace');
select is(public.test_hckr_rls_denied($$update public.board_columns set name = 'Denied' where id = 'column-owner'$$), false, 'other user update is filtered without changing board column');
select is(public.test_hckr_rls_denied($$update public.board_cards set title = 'Denied' where id = 'card-owner'$$), false, 'other user update is filtered without changing board card');
select is(public.test_hckr_rls_denied($$update public.saved_items set title = 'Denied' where id = 'item-owner'$$), false, 'other user update is filtered without changing saved item');
select is(public.test_hckr_rls_denied($$update public.saved_item_versions set content = 'Denied' where id = 'version-owner'$$), false, 'other user update is filtered without changing saved item version');

select * from finish();
rollback;
