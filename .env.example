# Public build configuration. Do not place a Supabase secret/service key in this file.
# Leave these unset for a local-only build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
# Set only in Cloud Sync release CI. The build then emits one exact host permission.
CLOUD_SYNC_REQUIRED=false
